# Rime text-to-speech — https://rime.ai
RIME_API_KEY=

# Qdrant Cloud vector database — https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Google Gemini — free tier key from https://aistudio.google.com/apikey
# Powers the agent (tool-calling/chat) and text embeddings.
GEMINI_API_KEY=

# Optional extra Gemini keys for quota failover. The free tier is capped per
# project per day, so adding keys from SEPARATE projects/accounts multiplies the
# daily request budget — the app rotates to the next key on a 429/quota error.
# GEMINI_API_KEY_2 through GEMINI_API_KEY_5 are supported.
GEMINI_API_KEY_2=
